{
  "name": "prd-field-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PRD Field Guide — how to write a product requirements doc an AI agent can build from, with a real one as the worked example.",
  "scripts": {
    "predev": "node scripts/make-mocks.mjs",
    "dev": "astro dev --port 4410 --force",
    "prebuild": "node scripts/make-mocks.mjs",
    "build": "astro build --force",
    "preview": "astro preview --port 4411",
    "check": "astro check",
    "test": "vitest run && node --test \"scripts/**/*.test.mjs\" \"scripts/check-*.mjs\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "sharp": "0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
