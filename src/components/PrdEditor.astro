---
import { withBase } from '../lib/base';
import { PRD_TEMPLATE } from '../lib/prd-template';

const blankDownloads = [
  { format: 'Markdown', extension: 'md' },
  { format: 'Word', extension: 'docx' },
  { format: 'PDF', extension: 'pdf' },
] as const;
---

<header class="editor-header">
  <h1>Create a product requirements document</h1>
  <p class="editor-lead">
    Use this template as a starting point. Add, remove, or change sections to fit your project.
  </p>
</header>

<noscript>
  <section class="editor-nojs">
    <p>The online editor needs JavaScript, but the blank files are available below.</p>
    <h2>Or start with a blank file</h2>
    <ul class="editor-blank-links">
      {
        blankDownloads.map(({ format, extension }) => (
          <li>
            <a href={withBase(`/downloads/prd-template.${extension}`)} download>
              Download the blank {format} template
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</noscript>

<div class="editor-page" data-prd-editor hidden>
  <section class="editor-status" aria-label="Draft status">
    <div class="editor-progress">
      <p><output id="completion-count">0 of 12 sections completed</output></p>
      <button id="continue-draft" class="editor-button editor-continue" type="button" hidden>
        Continue draft
      </button>
    </div>
    <p id="save-status" role="status" aria-live="polite" aria-atomic="true">
      Checking this browser for a saved draft.
    </p>
    <p class="editor-privacy">Your draft stays in this browser unless you download it.</p>
  </section>

  <div class="editor-shell">
    <form id="prd-editor-form" class="editor-form">
      <div class="editor-title-field">
        <label for="document-title">
          <span>Document title</span>
          <span class="field-state">Optional</span>
        </label>
        <input
          id="document-title"
          name="title"
          type="text"
          autocomplete="off"
          placeholder={PRD_TEMPLATE.defaultTitle}
        />
      </div>

      {
        PRD_TEMPLATE.sections.map((section, index) => (
          <section id={`section-${section.id}`} class="editor-section">
            <h2>
              <label for={`section-input-${section.id}`}>
                <span>{index + 1}. {section.title}</span>
                <span class="field-state">Optional</span>
              </label>
            </h2>
            <p id={`section-prompt-${section.id}`} class="editor-prompt">
              {section.prompt}
            </p>
            {section.helperQuestions && (
              <ul id={`section-questions-${section.id}`} class="editor-questions">
                {section.helperQuestions.map((question) => <li>{question}</li>)}
              </ul>
            )}
            <textarea
              id={`section-input-${section.id}`}
              name={section.id}
              rows="8"
              aria-describedby={`section-prompt-${section.id} section-questions-${section.id}`}
            />
          </section>
        ))
      }
    </form>

    <aside class="editor-tools" aria-label="Draft actions">
      <section id="downloads" class="editor-downloads" aria-labelledby="download-heading">
        <h2 id="download-heading">Download your PRD</h2>
        <p class="editor-group-label">Current draft</p>
        <label class="editor-export-option" for="include-blank-sections">
          <input id="include-blank-sections" type="checkbox" checked />
          <span>Include blank sections</span>
        </label>
        <div class="editor-download-actions">
          <button
            id="copy-markdown"
            class="editor-button"
            type="button"
          >
            Copy Markdown
          </button>
          <button
            id="download-md"
            class="editor-button"
            type="button"
            data-export-format="md"
          >
            Markdown (.md)
          </button>
          <button
            id="download-docx"
            class="editor-button"
            type="button"
            data-export-format="docx"
          >
            Word (.docx)
          </button>
          <button
            id="download-pdf"
            class="editor-button"
            type="button"
            data-export-format="pdf"
          >
            PDF (.pdf)
          </button>
        </div>
        <p
          id="download-status"
          class="editor-download-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          Files are generated in this browser.
        </p>
        <h3>Or start with a blank file</h3>
        <ul class="editor-blank-links">
          {
            blankDownloads.map(({ format, extension }) => (
              <li>
                <a
                  id={`blank-download-${extension}`}
                  href={withBase(`/downloads/prd-template.${extension}`)}
                  download
                >
                  {format} (.{extension})
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="editor-controls" aria-labelledby="controls-heading">
        <h2 id="controls-heading">Draft controls</h2>
        <div class="editor-actions">
          <button id="save-draft" class="editor-button editor-button--primary" type="button">
            Save draft
          </button>
          <button id="start-over" class="editor-button" type="button">Start over</button>
        </div>
        <div id="draft-conflict" class="editor-conflict" hidden>
          <p id="conflict-help" class="editor-backup-help">
            Saving and Start over are paused. Download a draft backup first to preserve
            this copy before choosing which draft to keep.
          </p>
          <div class="editor-actions">
            <button id="load-saved-draft" class="editor-button" type="button" aria-describedby="conflict-help">
              Load saved draft
            </button>
            <button id="keep-this-draft" class="editor-button" type="button" aria-describedby="conflict-help">
              Keep this draft
            </button>
          </div>
        </div>
        <p id="backup-help" class="editor-backup-help">
          A JSON backup reopens your editable draft, here or in another browser.
          Downloads and imports stay on your device. Import limit: 5 MiB.
        </p>
        <div class="editor-actions editor-backup-actions">
          <button id="download-backup" class="editor-button" type="button" aria-describedby="backup-help">
            Download draft backup
          </button>
          <button id="import-backup" class="editor-button" type="button" aria-describedby="backup-help">
            Import draft backup
          </button>
        </div>
        <input id="backup-file" type="file" accept=".json,application/json" hidden />
      </section>
    </aside>

    <aside class="editor-outline">
      <nav aria-labelledby="outline-heading">
        <h2 id="outline-heading">Document outline</h2>
        <ol>
          {
            PRD_TEMPLATE.sections.map((section) => (
              <li>
                <a href={`#section-${section.id}`} data-outline-target={section.id}>
                  {section.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>
  </div>
</div>

<script>
  import notoSansRegularUrl from '@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff?url';
  import notoSansBoldUrl from '@fontsource/noto-sans/files/noto-sans-latin-700-normal.woff?url';
  import {
    checkPrdEditorDraft,
    clearPrdEditorDraft,
    createBlankPrdEditorState,
    createPrdEditorDraftPayload,
    loadPrdEditorDraft,
    PRD_EDITOR_STORAGE_KEY,
    readPrdEditorBackup,
    savePrdEditorDraft,
    type PrdEditorState,
    type PrdEditorStorage,
  } from '../lib/prd-editor-state';
  import {
    exportPrdMarkdown,
    prdBytesResponseBody,
    prdExportFilename,
    PRD_EXPORT_MIME_TYPES,
    sanitizePrdFilename,
    type PrdExportFormat,
  } from '../lib/prd-export';
  import { PRD_TEMPLATE } from '../lib/prd-template';

  const editor = document.querySelector<HTMLElement>('[data-prd-editor]');
  const form = document.querySelector('#prd-editor-form');
  const titleInput = document.querySelector('#document-title');
  const completion = document.querySelector('#completion-count');
  const continueButton = document.querySelector('#continue-draft');
  const status = document.querySelector('#save-status');
  const saveButton = document.querySelector('#save-draft');
  const startOverButton = document.querySelector('#start-over');
  const conflictControls = document.querySelector('#draft-conflict');
  const loadSavedButton = document.querySelector('#load-saved-draft');
  const keepDraftButton = document.querySelector('#keep-this-draft');
  const downloadBackupButton = document.querySelector('#download-backup');
  const importBackupButton = document.querySelector('#import-backup');
  const backupFileInput = document.querySelector('#backup-file');
  const downloadStatus = document.querySelector('#download-status');
  const copyMarkdownButton = document.querySelector('#copy-markdown');
  const includeBlankSectionsInput = document.querySelector('#include-blank-sections');
  const downloadButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-export-format]'),
  );

  if (
    !editor ||
    !(form instanceof HTMLFormElement) ||
    !(titleInput instanceof HTMLInputElement) ||
    !(completion instanceof HTMLOutputElement) ||
    !(continueButton instanceof HTMLButtonElement) ||
    !(status instanceof HTMLParagraphElement) ||
    !(saveButton instanceof HTMLButtonElement) ||
    !(startOverButton instanceof HTMLButtonElement) ||
    !(conflictControls instanceof HTMLDivElement) ||
    !(loadSavedButton instanceof HTMLButtonElement) ||
    !(keepDraftButton instanceof HTMLButtonElement) ||
    !(downloadBackupButton instanceof HTMLButtonElement) ||
    !(importBackupButton instanceof HTMLButtonElement) ||
    !(backupFileInput instanceof HTMLInputElement) ||
    !(downloadStatus instanceof HTMLParagraphElement) ||
    !(copyMarkdownButton instanceof HTMLButtonElement) ||
    !(includeBlankSectionsInput instanceof HTMLInputElement) ||
    downloadButtons.length !== 3
  ) {
    throw new Error('The PRD editor markup is incomplete.');
  }

  const sectionInputs = new Map(
    PRD_TEMPLATE.sections.map((section) => {
      const input = document.querySelector(`#section-input-${section.id}`);
      if (!(input instanceof HTMLTextAreaElement)) {
        throw new Error(`The PRD editor field "${section.id}" is missing.`);
      }
      return [section.id, input] as const;
    }),
  );

  const showStatus = (message: string, state: string) => {
    if (status.textContent !== message) status.textContent = message;
    status.dataset.state = state;
  };

  const showDownloadStatus = (message: string, state: string) => {
    downloadStatus.textContent = message;
    downloadStatus.dataset.state = state;
  };

  const dateFormatter = new Intl.DateTimeFormat(undefined, {
    dateStyle: 'medium',
    timeStyle: 'short',
  });
  const formatSavedAt = (savedAt: string) =>
    dateFormatter.format(new Date(savedAt));

  // Preserve imported line endings even when native form controls normalize them.
  const originalValues = new Map<
    HTMLInputElement | HTMLTextAreaElement,
    { original: string; rendered: string }
  >();
  const readField = (input: HTMLInputElement | HTMLTextAreaElement) => {
    const previous = originalValues.get(input);
    return previous && input.value === previous.rendered ? previous.original : input.value;
  };
  const applyField = (input: HTMLInputElement | HTMLTextAreaElement, value: string) => {
    input.value = value;
    if (input.value !== value) {
      originalValues.set(input, { original: value, rendered: input.value });
    } else {
      originalValues.delete(input);
    }
  };

  const readState = (): PrdEditorState => {
    const blank = createBlankPrdEditorState();
    const values = { ...blank.values };
    for (const section of PRD_TEMPLATE.sections) {
      const input = sectionInputs.get(section.id);
      values[section.id] = input ? readField(input) : '';
    }
    return { title: readField(titleInput), values };
  };

  const applyState = (state: PrdEditorState) => {
    applyField(titleInput, state.title);
    for (const section of PRD_TEMPLATE.sections) {
      const input = sectionInputs.get(section.id);
      if (input) applyField(input, state.values[section.id]);
    }
  };

  const updateCompletion = () => {
    const completed = Array.from(sectionInputs.values()).filter(
      (input) => input.value.trim().length > 0,
    ).length;
    const message = `${completed} of ${PRD_TEMPLATE.sections.length} sections completed`;
    if (completion.textContent !== message) completion.textContent = message;
    continueButton.hidden = completed === PRD_TEMPLATE.sections.length;
  };

  let storage: PrdEditorStorage | undefined;
  try {
    storage = window.localStorage;
  } catch {
    showStatus(
      'This browser did not allow access to local draft storage. You can still edit this document.',
      'error',
    );
  }

  let baseline: string | null | undefined;
  let conflict = false;
  let observedRaw: string | null | undefined;
  let storageReadFailed = !storage;
  let autoSaveTimer: number | undefined;
  const cancelAutoSave = () => {
    if (autoSaveTimer !== undefined) window.clearTimeout(autoSaveTimer);
    autoSaveTimer = undefined;
  };
  const stateSignature = () => JSON.stringify(readState());
  let safeStateSignature = stateSignature();
  let importedDraftAtRisk = false;
  let leaveWarningRegistered = false;
  let leaveAttempted = false;
  const hasAtRiskLocalCopy = () => {
    const current = readState();
    const hasContent = [current.title, ...Object.values(current.values)]
      .some((value) => value.length > 0);
    return importedDraftAtRisk ||
      JSON.stringify(current) !== safeStateSignature ||
      (conflict && hasContent);
  };
  const handleBeforeUnload = (event: BeforeUnloadEvent) => {
    if (!hasAtRiskLocalCopy()) {
      syncLeaveWarning();
      return;
    }
    leaveAttempted = true;
    cancelAutoSave();
    persistDraft('automatic');
    if (!hasAtRiskLocalCopy()) return;
    event.preventDefault();
    event.returnValue = true;
    window.setTimeout(() => {
      leaveAttempted = false;
    }, 0);
  };
  function syncLeaveWarning() {
    const shouldWarn = hasAtRiskLocalCopy();
    if (shouldWarn === leaveWarningRegistered) return;
    leaveWarningRegistered = shouldWarn;
    if (shouldWarn) window.addEventListener('beforeunload', handleBeforeUnload);
    else window.removeEventListener('beforeunload', handleBeforeUnload);
  }
  const conflictMessage =
    'Saving is paused because the saved draft changed in another tab. Your text is unchanged. Use Draft controls to load the saved draft or keep this draft.';
  const showConflict = (raw: string | null, message = conflictMessage) => {
    cancelAutoSave();
    conflict = true;
    observedRaw = raw;
    conflictControls.hidden = false;
    saveButton.setAttribute('aria-disabled', 'true');
    startOverButton.setAttribute('aria-disabled', 'true');
    showStatus(message, 'conflict');
    syncLeaveWarning();
  };
  const clearConflict = () => {
    conflict = false;
    observedRaw = undefined;
    storageReadFailed = false;
    conflictControls.hidden = true;
    saveButton.removeAttribute('aria-disabled');
    startOverButton.removeAttribute('aria-disabled');
    syncLeaveWarning();
  };
  const showReadFailure = () => {
    cancelAutoSave();
    storageReadFailed = true;
    showStatus(
      'Saving is paused because this browser could not read local draft storage. Your text is unchanged. Download a draft backup before leaving; try again when storage is available.',
      conflict ? 'conflict' : 'error',
    );
    syncLeaveWarning();
  };
  const checkForChanges = () => {
    if (!storage) {
      showReadFailure();
      return false;
    }
    const checked = checkPrdEditorDraft(storage, baseline);
    if (checked.status === 'storage-error') {
      showReadFailure();
      return false;
    }
    const wasUnreadable = storageReadFailed;
    storageReadFailed = false;
    if (checked.status === 'conflict' || conflict) {
      if (!conflict || checked.raw !== observedRaw || wasUnreadable) {
        showConflict(checked.raw);
      }
      return false;
    }
    if (wasUnreadable) {
      showStatus('Browser storage is readable again. Save this draft to keep your unsaved changes.', 'pending');
    }
    return true;
  };

  const writeDraft = (
    expectedRaw: string | null | undefined,
    mode: 'automatic' | 'explicit' | 'import',
  ) => {
    const failureMessage = mode === 'import'
      ? 'Draft backup imported into the editor, but not saved in this browser. You can keep editing; download a draft backup before leaving.'
      : 'Draft could not be saved in this browser. You can still edit, but copy your work before leaving.';
    if (!storage) {
      showStatus(
        failureMessage,
        'error',
      );
      syncLeaveWarning();
      return;
    }

    const result = savePrdEditorDraft(storage, readState(), expectedRaw);
    if (result.status === 'conflict') {
      showConflict(result.raw, mode === 'import'
        ? 'Draft backup imported into the editor, but not saved. Saving is paused because the saved draft changed in another tab. Download a draft backup before choosing which copy to keep.'
        : 'Saving is paused because the saved draft changed again. Your text is unchanged. Review the latest saved draft and choose again.');
      return;
    }
    if (result.status === 'storage-error') {
      showStatus(
        conflict ? `${failureMessage} Saving is still paused; choose again to retry.` : failureMessage,
        conflict ? 'conflict' : 'error',
      );
      syncLeaveWarning();
      return;
    }

    baseline = result.raw;
    safeStateSignature = stateSignature();
    importedDraftAtRisk = false;
    clearConflict();
    const lead = mode === 'import'
      ? 'Draft backup imported and saved'
      : mode === 'automatic' ? 'Draft saved automatically' : 'Draft saved';
    showStatus(
      `${lead} in this browser at ${formatSavedAt(result.payload.savedAt)}.`,
      'saved',
    );
  };

  const persistDraft = (mode: 'automatic' | 'explicit' | 'import') => {
    const ready = checkForChanges();
    if (conflict) {
      if (mode === 'import' && observedRaw !== undefined) {
        showConflict(observedRaw, 'Draft backup imported into the editor, but not saved. Saving is paused because the saved draft changed in another tab. Download a draft backup before choosing which copy to keep.');
      }
      return;
    }
    if (!ready) {
      if (mode === 'import') {
        showStatus(
          'Draft backup imported into the editor, but not saved in this browser. You can keep editing; download a draft backup before leaving.',
          'error',
        );
      }
      return;
    }
    writeDraft(baseline, mode);
  };

  if (storage) {
    const restored = loadPrdEditorDraft(storage);
    if (restored.status !== 'storage-error') baseline = restored.raw;
    switch (restored.status) {
      case 'valid':
        applyState(restored.payload.state);
        showStatus(
          `Draft restored from this browser. Last saved ${formatSavedAt(restored.payload.savedAt)}.`,
          'restored',
        );
        break;
      case 'empty':
        showStatus('No draft saved in this browser yet.', 'empty');
        break;
      case 'unsupported-version':
        showStatus(
          `The saved draft uses unsupported version ${restored.version} and was not restored. Save this draft to replace it, or start over to remove it.`,
          'error',
        );
        break;
      case 'corrupt':
        showStatus(
          'The saved draft in this browser is damaged and was not restored. Save this draft to replace it, or start over to remove it.',
          'error',
        );
        break;
      case 'storage-error':
        storageReadFailed = true;
        showStatus(
          'This browser could not read local draft storage. You can still edit this document.',
          'error',
        );
        break;
    }
  }
  safeStateSignature = stateSignature();
  syncLeaveWarning();

  updateCompletion();
  editor.hidden = false;

  form.addEventListener('input', (event) => {
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
      originalValues.delete(event.target);
    }
    updateCompletion();
    cancelAutoSave();
    syncLeaveWarning();
    if (conflict) return;
    if (storageReadFailed) {
      showReadFailure();
      return;
    }
    showStatus('Unsaved changes. Saving in this browser.', 'pending');
    autoSaveTimer = window.setTimeout(() => {
      autoSaveTimer = undefined;
      persistDraft('automatic');
    }, 400);
  });

  saveButton.addEventListener('click', () => {
    cancelAutoSave();
    persistDraft('explicit');
  });

  const hasLocalContent = () => {
    const current = readState();
    return [current.title, ...Object.values(current.values)].some((value) => value.length > 0);
  };
  const readResolution = () => {
    if (!storage) {
      showReadFailure();
      return;
    }
    const current = loadPrdEditorDraft(storage);
    if (current.status === 'storage-error') {
      showReadFailure();
      return;
    }
    return current;
  };
  loadSavedButton.addEventListener('click', () => {
    if (!conflict) return;
    const current = readResolution();
    if (!current || !storage) return;
    if (current.status === 'corrupt' || current.status === 'unsupported-version') {
      const reason = current.status === 'unsupported-version'
        ? `uses unsupported version ${current.version}; this editor supports version 1`
        : current.reason === 'json'
          ? 'is not valid JSON'
          : current.reason === 'fields'
            ? 'must include a text title and all 12 sections as text'
            : 'has a missing or damaged version, saved timestamp, or draft structure';
      showConflict(current.raw, `The saved draft ${reason}. It was not loaded. Your text is unchanged and saving is paused.`);
      return;
    }
    if ((current.status === 'empty' || hasLocalContent()) && !window.confirm(
      current.status === 'empty'
        ? 'The saved draft was removed in another tab. Load an empty draft and clear all current fields? Download a draft backup first to keep this copy.'
        : 'Load the saved draft and replace all current fields? Download a draft backup first if you want to keep both copies.',
    )) {
      showConflict(current.raw, 'Loading canceled. Your text is unchanged and saving is paused.');
      return;
    }
    const checked = checkPrdEditorDraft(storage, current.raw);
    if (checked.status === 'storage-error') {
      showReadFailure();
      return;
    }
    if (checked.status === 'conflict') {
      showConflict(checked.raw, 'Saving is paused because the saved draft changed again. Nothing was loaded. Review the latest saved draft and choose again.');
      return;
    }
    cancelAutoSave();
    applyState(current.status === 'empty' ? createBlankPrdEditorState() : current.payload.state);
    updateCompletion();
    baseline = current.raw;
    safeStateSignature = stateSignature();
    importedDraftAtRisk = false;
    clearConflict();
    showStatus(current.status === 'empty'
      ? 'The saved draft was removed. An empty draft is now loaded.'
      : `Draft loaded from this browser. Last saved ${formatSavedAt(current.payload.savedAt)}.`,
    current.status === 'empty' ? 'empty' : 'restored');
  });
  keepDraftButton.addEventListener('click', () => {
    if (!conflict) return;
    const current = readResolution();
    if (!current) return;
    if (!window.confirm(
      'Keep this draft and replace the current browser-saved copy with all fields from this tab? Download a draft backup first if you want to preserve both copies.',
    )) {
      showConflict(current.raw, 'Keeping this draft was canceled. Your text is unchanged and saving is paused.');
      return;
    }
    writeDraft(current.raw, 'explicit');
  });

  window.addEventListener('storage', (event) => {
    if (event.storageArea === storage && (event.key === PRD_EDITOR_STORAGE_KEY || event.key === null)) {
      checkForChanges();
    }
  });
  window.addEventListener('focus', () => { checkForChanges(); });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') checkForChanges();
  });

  let pdfFonts:
    | Promise<{ regular: Uint8Array; bold: Uint8Array }>
    | undefined;
  const loadPdfFonts = () => {
    if (pdfFonts) return pdfFonts;
    const pending = Promise.all(
      [notoSansRegularUrl, notoSansBoldUrl].map(async (url) => {
        const response = await fetch(url);
        if (!response.ok) {
          throw new Error(`PDF font request failed with status ${response.status}.`);
        }
        return new Uint8Array(await response.arrayBuffer());
      }),
    ).then(([regular, bold]) => ({ regular, bold }));
    pdfFonts = pending;
    void pending.catch(() => {
      if (pdfFonts === pending) pdfFonts = undefined;
    });
    return pending;
  };

  const generateDownload = async (
    format: PrdExportFormat,
    state: PrdEditorState,
  ): Promise<Uint8Array> => {
    const options = {
      includeBlankSections: includeBlankSectionsInput.checked,
    };
    switch (format) {
      case 'md':
        return exportPrdMarkdown(state, options);
      case 'docx': {
        const { exportPrdDocx } = await import('../lib/prd-export-docx');
        return exportPrdDocx(state, options);
      }
      case 'pdf': {
        const [{ generatePrdPdf }, fonts] = await Promise.all([
          import('../lib/prd-export-pdf'),
          loadPdfFonts(),
        ]);
        return (await generatePrdPdf(state, fonts, options)).bytes;
      }
    }
  };

  const startDownload = (
    blob: Blob,
    filename: string,
  ) => {
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.hidden = true;
    document.body.append(link);
    try {
      link.click();
    } finally {
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 0);
    }
  };

  copyMarkdownButton.addEventListener('click', async () => {
    downloadStatus.textContent = '';
    downloadStatus.dataset.state = 'pending';
    if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
      showDownloadStatus(
        'Clipboard access is unavailable. Use the Markdown (.md) download instead.',
        'error',
      );
      return;
    }

    const markdown = new TextDecoder().decode(exportPrdMarkdown(readState(), {
      includeBlankSections: includeBlankSectionsInput.checked,
    }));
    copyMarkdownButton.disabled = true;
    copyMarkdownButton.setAttribute('aria-busy', 'true');
    try {
      await navigator.clipboard.writeText(markdown);
      showDownloadStatus('Copied Markdown to the clipboard.', 'copied');
    } catch (error) {
      console.error('Could not copy Markdown to the clipboard.', error);
      showDownloadStatus(
        'Could not copy Markdown to the clipboard. Use the Markdown (.md) download instead.',
        'error',
      );
    } finally {
      copyMarkdownButton.disabled = false;
      copyMarkdownButton.removeAttribute('aria-busy');
    }
  });

  for (const button of downloadButtons) {
    button.addEventListener('click', async () => {
      const format = button.dataset.exportFormat as PrdExportFormat;
      const state = readState();
      const filename = prdExportFilename(state.title, format);
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      showDownloadStatus(`Generating ${filename}.`, 'pending');
      try {
        const bytes = await generateDownload(format, state);
        startDownload(new Blob([prdBytesResponseBody(bytes)], {
          type: PRD_EXPORT_MIME_TYPES[format],
        }), filename);
        showDownloadStatus(`Downloaded ${filename}.`, 'downloaded');
      } catch (error) {
        console.error(`Could not generate ${format} download.`, error);
        showDownloadStatus(
          `Download failed for ${filename}. Your draft is unchanged.`,
          'error',
        );
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  }

  downloadBackupButton.addEventListener('click', () => {
    const state = readState();
    const filename = `${sanitizePrdFilename(state.title)}.prd.json`;
    try {
      const blob = new Blob([JSON.stringify(createPrdEditorDraftPayload(state))], {
        type: 'application/json;charset=utf-8',
      });
      startDownload(blob, filename);
      showDownloadStatus(`Downloaded ${filename}. Use Import draft backup to reopen it.`, 'downloaded');
    } catch {
      showDownloadStatus('Draft backup download failed. Your draft is unchanged.', 'error');
    }
  });

  let importInProgress = false;
  importBackupButton.addEventListener('click', () => {
    backupFileInput.value = '';
    backupFileInput.click();
  });

  backupFileInput.addEventListener('change', async () => {
    const file = backupFileInput.files?.[0];
    if (!file || importInProgress) return;
    importInProgress = true;
    importBackupButton.disabled = true;
    backupFileInput.disabled = true;
    importBackupButton.setAttribute('aria-busy', 'true');
    try {
      const result = await readPrdEditorBackup(file);
      if (result.status !== 'valid') {
        let message: string;
        switch (result.status) {
          case 'too-large':
            message = 'This file is too large. Choose a draft backup of 5 MiB or less.';
            break;
          case 'unreadable':
            message = 'This file could not be read. Choose it again or try another copy.';
            break;
          case 'unsupported-version':
            message = `This backup uses unsupported version ${result.version}. This editor supports version 1.`;
            break;
          case 'corrupt':
            message = result.reason === 'json'
              ? 'This file is not valid JSON. Choose a .prd.json draft backup.'
              : result.reason === 'fields'
                ? 'This backup must include a text title and all 12 sections as text. A field is missing or is not text.'
                : 'This file is not a valid draft backup. Its version, saved timestamp, or draft structure is missing or damaged.';
            break;
        }
        showDownloadStatus(`${message} Your draft is unchanged.`, 'error');
        return;
      }

      checkForChanges();
      if (conflict) {
        showDownloadStatus('Import paused because the saved draft changed in another tab. Your draft is unchanged. Resolve the saved draft choice, then import again.', 'error');
        return;
      }
      // Read after the asynchronous file read so confirmation covers the latest edits.
      if (hasLocalContent() && !window.confirm(
        'Replace the current draft with this backup? This replaces all fields and the draft saved in this browser. Download a backup first if you want to keep both.',
      )) {
        showDownloadStatus('Import canceled. Your draft is unchanged.', 'canceled');
        return;
      }

      checkForChanges();
      if (conflict) {
        showDownloadStatus('Import paused because the saved draft changed during confirmation. Your draft is unchanged. Resolve the saved draft choice, then import again.', 'error');
        return;
      }
      cancelAutoSave();
      applyState(result.payload.state);
      updateCompletion();
      importedDraftAtRisk = true;
      syncLeaveWarning();
      showDownloadStatus('', 'idle');
      persistDraft('import');
      titleInput.focus();
    } finally {
      backupFileInput.value = '';
      backupFileInput.disabled = false;
      importBackupButton.disabled = false;
      importBackupButton.removeAttribute('aria-busy');
      importInProgress = false;
    }
  });

  startOverButton.addEventListener('click', () => {
    if (!checkForChanges()) return;
    const confirmed = window.confirm(
      'Start over? This removes the local draft from this browser and clears all fields.',
    );
    if (!confirmed) return;
    if (!checkForChanges() || !storage) return;
    cancelAutoSave();
    const result = clearPrdEditorDraft(storage, baseline);
    if (result.status === 'conflict') {
      showConflict(result.raw);
      return;
    }
    if (result.status === 'storage-error') {
      showStatus('The local draft could not be removed from this browser. Your current fields are unchanged.', 'error');
      return;
    }
    baseline = null;
    originalValues.clear();
    form.reset();
    updateCompletion();
    safeStateSignature = stateSignature();
    importedDraftAtRisk = false;
    syncLeaveWarning();
    showStatus('Local draft removed. All fields are clear.', 'cleared');
    titleInput.focus();
  });

  const navigateToSection = (id: string) => {
    const section = PRD_TEMPLATE.sections.find((candidate) => candidate.id === id);
    const input = section ? sectionInputs.get(section.id) : undefined;
    const container = section ? document.getElementById(`section-${section.id}`) : null;
    if (!section || !input || !container) return false;
    history.replaceState(null, '', `#section-${section.id}`);
    input.focus({ preventScroll: true });
    container.scrollIntoView({ behavior: 'instant', block: 'start' });
    return true;
  };

  continueButton.addEventListener('click', () => {
    const firstIncomplete = PRD_TEMPLATE.sections.find((section) =>
      sectionInputs.get(section.id)?.value.trim().length === 0
    );
    if (firstIncomplete) navigateToSection(firstIncomplete.id);
  });

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-outline-target]')) {
    link.addEventListener('click', (event) => {
      const id = link.dataset.outlineTarget;
      if (id && navigateToSection(id)) event.preventDefault();
    });
  }

  window.addEventListener('pagehide', () => {
    if (leaveAttempted || !hasAtRiskLocalCopy()) return;
    leaveAttempted = true;
    cancelAutoSave();
    persistDraft('automatic');
  });
</script>

