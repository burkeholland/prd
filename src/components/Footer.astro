---
import { SITE } from '../lib/site';
import { withBase } from '../lib/base';

const REFERENCE_ITEMS = [
  { href: '/guide/', label: 'Guide' },
  { href: '/walkthrough/', label: 'Walkthrough' },
  { href: '/template/', label: 'Template' },
  { href: '/history/', label: 'History' },
] as const;

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
const references = REFERENCE_ITEMS.map((item) => {
  const href = withBase(item.href);
  const target = normalize(href);
  return {
    ...item,
    href,
    current: current === target || (item.href === '/history/' && current.startsWith(`${target}/`)),
  };
});
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <nav class="site-footer__references" aria-labelledby="footer-references-label">
      <p id="footer-references-label" class="site-footer__label">References</p>
      <ul>
        {
          references.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="site-footer__sources" aria-label="Source and support">
      <li><a href={SITE.gistUrl}>Example source</a></li>
      <li><a href={SITE.repoUrl}>Site source</a></li>
      <li><a href={`${SITE.repoUrl}/issues/new`}>Report a problem</a></li>
    </ul>
  </div>
</footer>
