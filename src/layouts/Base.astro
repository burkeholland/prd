---
import '../styles/global.css';
import '../styles/print.css';
import Nav from '../components/Nav.astro';
import ThemeControl from '../components/ThemeControl.astro';
import ReaderTextSizeControl from '../components/ReaderTextSizeControl.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { withBase } from '../lib/base';
import { canonicalUrl, OG_IMAGE, socialCard } from '../lib/seo';
import { THEME_STORAGE_KEY } from '../lib/theme';
import { READER_TEXT_SIZE_STORAGE_KEY } from '../lib/reader-text-size';

interface Props {
  title: string;
  description?: string;
  /** Pages that must not be indexed or shared emit `robots: noindex` and no `og:url`. */
  noindex?: boolean;
  /** Opt a noindex page into its canonical link when that URL is still a useful public artifact. */
  canonical?: boolean;
}

const {
  title,
  description = SITE.tagline,
  noindex = false,
  canonical: canonicalOverride,
} = Astro.props;

if (!Astro.site) {
  throw new Error('astro.config.mjs must set `site`: canonical URLs and the social preview need an absolute origin.');
}
const canonical =
  (canonicalOverride ?? !noindex)
    ? canonicalUrl(Astro.url.pathname, Astro.site)
    : undefined;
const card = socialCard(Astro.url.pathname, import.meta.env.BASE_URL);
const ogImage = new URL(withBase(card.file), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ themeStorageKey: THEME_STORAGE_KEY }}>
      try {
        const savedTheme = window.localStorage.getItem(themeStorageKey);
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {
        // System remains the truthful default when storage is unavailable.
      }
    </script>
    <script
      is:inline
      define:vars={{ readerTextSizeStorageKey: READER_TEXT_SIZE_STORAGE_KEY }}
    >
      try {
        const savedTextSize = window.localStorage.getItem(
          readerTextSizeStorageKey,
        );
        if (savedTextSize === 'large') {
          document.documentElement.dataset.textSize = savedTextSize;
        }
      } catch {
        // Default remains the truthful value when storage is unavailable.
      }
    </script>
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={card.alt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={withBase('/')}>{SITE.name}</a>
        <Nav current={Astro.url.pathname} />
        <ThemeControl />
        <ReaderTextSizeControl />
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
