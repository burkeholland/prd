---
import '../styles/global.css';
import '../styles/print.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { withBase } from '../lib/base';
import { canonicalUrl, OG_IMAGE, socialCard } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Pages that must not be indexed or shared (the 404 page): emits `robots: noindex`, no canonical, no `og:url`. */
  noindex?: boolean;
}

const { title, description = SITE.tagline, noindex = false } = Astro.props;

if (!Astro.site) {
  throw new Error('astro.config.mjs must set `site`: canonical URLs and the social preview need an absolute origin.');
}
const canonical = noindex ? undefined : canonicalUrl(Astro.url.pathname, Astro.site);
const card = socialCard(Astro.url.pathname, import.meta.env.BASE_URL);
const ogImage = new URL(withBase(card.file), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={card.alt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={withBase('/')}>{SITE.name}</a>
        <Nav current={Astro.url.pathname} />
      </div>
    </header>
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
