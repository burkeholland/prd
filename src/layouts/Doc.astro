---
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import { buildToc, type Heading } from '../lib/toc';
import { PLACEHOLDER, SITE } from '../lib/site';

type DocEntry = CollectionEntry<'docs'> | CollectionEntry<'gist'>;

interface Props {
  /** Nav label for this route; the fallback for `title` when the content has none. */
  label: string;
  /** The page's h1; the <title> (and so og:title) starts with it, not with the nav label. */
  title?: string;
  description?: string;
  /** Missing on branches where `content/` has not merged yet — the page shows a placeholder. */
  entry?: DocEntry;
  /** Headings supplied by a model-driven document body. */
  headings?: readonly Heading[];
}

const { label, entry, title = label, description, headings } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const toc = buildToc(headings ?? rendered?.headings ?? []);
const hasToc = toc.length > 0;
---

<Base title={`${title} · ${SITE.name}`} description={description}>
  <article class="doc">
    <header class="doc__header">
      <slot name="header">
        <h1>{title}</h1>
        {description && <p class="doc__description">{description}</p>}
      </slot>
    </header>

    {
      hasToc && (
        <details class="toc toc--inline">
          <summary>On this page</summary>
          <Toc items={toc} />
        </details>
      )
    }

    <div class="doc__body prose">
      {Content ? <Content /> : <p class="placeholder">{PLACEHOLDER}</p>}
      <slot />
    </div>

    {
      hasToc && (
        <aside class="toc toc--sidebar">
          <nav aria-label="On this page">
            <p class="toc__title">On this page</p>
            <Toc items={toc} />
          </nav>
        </aside>
      )
    }
  </article>
</Base>

<script>
  const header = document.querySelector<HTMLElement>('article.doc > header.doc__header');
  const body = document.querySelector<HTMLElement>('article.doc > .doc__body');
  const article = body?.closest<HTMLElement>('article.doc');
  const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
  const clipboard = navigator.clipboard;
  const canCopy = canonical && typeof clipboard?.writeText === 'function';
  const canPrint = typeof window.print === 'function';

  if (header && (canCopy || canPrint)) {
    const action = document.createElement('p');
    action.className = 'doc__page-actions doc__print-action';

    if (canCopy) {
      const RESET_LABEL = 'Copy page link';
      const RESET_DELAY = 1500;
      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'doc__page-action-button doc__copy-button';
      copyButton.textContent = RESET_LABEL;
      copyButton.setAttribute('aria-busy', 'false');

      const status = document.createElement('span');
      status.className = 'doc__page-status';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      copyButton.addEventListener('click', async () => {
        if (copyButton.getAttribute('aria-busy') === 'true') return;

        clearTimeout(resetTimer);
        copyButton.setAttribute('aria-busy', 'true');
        copyButton.textContent = 'Copying link';
        delete copyButton.dataset.state;
        status.textContent = '';

        try {
          await clipboard.writeText(canonical.href);
          copyButton.textContent = 'Link copied';
          copyButton.dataset.state = 'copied';
          status.textContent = 'Page link copied.';
        } catch {
          copyButton.textContent = 'Copy failed';
          status.textContent = 'Page link could not be copied.';
        } finally {
          copyButton.setAttribute('aria-busy', 'false');
          resetTimer = setTimeout(() => {
            copyButton.textContent = RESET_LABEL;
            delete copyButton.dataset.state;
          }, RESET_DELAY);
        }
      });

      action.append(copyButton, status);
    }

    if (canPrint) {
      const printButton = document.createElement('button');
      printButton.type = 'button';
      printButton.className = 'doc__page-action-button doc__print-button';
      printButton.textContent = 'Print this page';
      action.append(printButton);

      const restoreFocus = () => {
        if (printButton.isConnected) printButton.focus({ preventScroll: true });
      };

      printButton.addEventListener('click', () => {
        restoreFocus();
        window.addEventListener('afterprint', restoreFocus, { once: true });
        window.print();
        restoreFocus();
      });
    }

    header.append(action);
  }

  if (article && body && canCopy) {
    const headings = Array.from(
      body.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]'),
    ).flatMap((heading) => {
      const style = getComputedStyle(heading);
      if (
        heading.id.trim() === '' ||
        heading.closest('[hidden], [aria-hidden="true"]') ||
        style.display === 'none' ||
        style.visibility === 'hidden'
      ) {
        return [];
      }

      return [{
        heading,
        offset:
          Number.parseFloat(style.marginBlockStart) +
          Number.parseFloat(style.paddingBlockStart),
      }];
    });

    if (headings.length > 0) {
      const RESET_LABEL = 'Copy section link';
      const RESET_DELAY = 1500;
      const status = document.createElement('span');
      status.className = 'doc__section-status';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');
      article.append(status);

      const sectionButtons: HTMLButtonElement[] = [];
      let sectionCopyPending = false;
      let pendingButton: HTMLButtonElement | undefined;

      for (const { heading, offset } of headings) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'doc__section-link-button';
        button.textContent = RESET_LABEL;
        button.setAttribute('aria-label', RESET_LABEL);
        button.setAttribute('aria-describedby', heading.id);
        // The preceding float keeps the heading itself untouched; carry its block-start spacing
        // onto the action so the two controls share a line in every document's heading layout.
        button.style.marginBlockStart = `${offset}px`;
        sectionButtons.push(button);
        heading.before(button);

        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        button.addEventListener('click', async () => {
          if (sectionCopyPending) {
            pendingButton?.focus({ preventScroll: true });
            return;
          }

          sectionCopyPending = true;
          pendingButton = button;
          clearTimeout(resetTimer);
          button.setAttribute('aria-busy', 'true');
          for (const sectionButton of sectionButtons) {
            sectionButton.setAttribute('aria-disabled', 'true');
          }
          button.textContent = 'Copying link';
          delete button.dataset.state;
          status.textContent = '';

          try {
            await clipboard.writeText(`${canonical.href}#${encodeURIComponent(heading.id)}`);
            button.textContent = 'Link copied';
            button.dataset.state = 'copied';
            status.textContent = 'Section link copied.';
          } catch {
            button.textContent = 'Copy failed';
            button.dataset.state = 'failed';
            status.textContent = 'Section link could not be copied.';
          } finally {
            for (const sectionButton of sectionButtons) {
              sectionButton.removeAttribute('aria-disabled');
            }
            button.removeAttribute('aria-busy');
            sectionCopyPending = false;
            pendingButton = undefined;
            resetTimer = setTimeout(() => {
              button.textContent = RESET_LABEL;
              delete button.dataset.state;
            }, RESET_DELAY);
          }
        });
      }
    }
  }
</script>
