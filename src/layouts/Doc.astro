---
import { render, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Toc from '../components/Toc.astro';
import { buildToc, type Heading } from '../lib/toc';
import { PLACEHOLDER, SITE } from '../lib/site';

type DocEntry = CollectionEntry<'docs'> | CollectionEntry<'gist'>;

interface Props {
  /** Nav label for this route; the fallback for `title` when the content has none. */
  label: string;
  /** The page's h1; the <title> (and so og:title) starts with it, not with the nav label. */
  title?: string;
  description?: string;
  /** Missing on branches where `content/` has not merged yet — the page shows a placeholder. */
  entry?: DocEntry;
  /** Headings supplied by a model-driven document body. */
  headings?: readonly Heading[];
}

const { label, entry, title = label, description, headings } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const toc = buildToc(headings ?? rendered?.headings ?? []);
const hasToc = toc.length > 0;
---

<Base title={`${title} · ${SITE.name}`} description={description}>
  <article class="doc">
    <header class="doc__header">
      <slot name="header">
        <h1>{title}</h1>
        {description && <p class="doc__description">{description}</p>}
      </slot>
    </header>

    {
      hasToc && (
        <details class="toc toc--inline">
          <summary>On this page</summary>
          <Toc items={toc} />
        </details>
      )
    }

    <div class="doc__body prose">
      {Content ? <Content /> : <p class="placeholder">{PLACEHOLDER}</p>}
      <slot />
    </div>

    {
      hasToc && (
        <aside class="toc toc--sidebar">
          <nav aria-label="On this page">
            <p class="toc__title">On this page</p>
            <Toc items={toc} />
          </nav>
        </aside>
      )
    }
  </article>
</Base>

<script>
  const header = document.querySelector<HTMLElement>('article.doc > header.doc__header');
  const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
  const clipboard = navigator.clipboard;
  const canCopy = canonical && typeof clipboard?.writeText === 'function';
  const canPrint = typeof window.print === 'function';

  if (header && (canCopy || canPrint)) {
    const action = document.createElement('p');
    action.className = 'doc__page-actions doc__print-action';

    if (canCopy) {
      const RESET_LABEL = 'Copy page link';
      const RESET_DELAY = 1500;
      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'doc__page-action-button doc__copy-button';
      copyButton.textContent = RESET_LABEL;
      copyButton.setAttribute('aria-busy', 'false');

      const status = document.createElement('span');
      status.className = 'doc__page-status';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      copyButton.addEventListener('click', async () => {
        if (copyButton.getAttribute('aria-busy') === 'true') return;

        clearTimeout(resetTimer);
        copyButton.setAttribute('aria-busy', 'true');
        copyButton.textContent = 'Copying link';
        delete copyButton.dataset.state;
        status.textContent = '';

        try {
          await clipboard.writeText(canonical.href);
          copyButton.textContent = 'Link copied';
          copyButton.dataset.state = 'copied';
          status.textContent = 'Page link copied.';
        } catch {
          copyButton.textContent = 'Copy failed';
          status.textContent = 'Page link could not be copied.';
        } finally {
          copyButton.setAttribute('aria-busy', 'false');
          resetTimer = setTimeout(() => {
            copyButton.textContent = RESET_LABEL;
            delete copyButton.dataset.state;
          }, RESET_DELAY);
        }
      });

      action.append(copyButton, status);
    }

    if (canPrint) {
      const printButton = document.createElement('button');
      printButton.type = 'button';
      printButton.className = 'doc__page-action-button doc__print-button';
      printButton.textContent = 'Print this page';
      action.append(printButton);

      const restoreFocus = () => {
        if (printButton.isConnected) printButton.focus({ preventScroll: true });
      };

      printButton.addEventListener('click', () => {
        restoreFocus();
        window.addEventListener('afterprint', restoreFocus, { once: true });
        window.print();
        restoreFocus();
      });
    }

    header.append(action);
  }
</script>
