---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';

const cards = [
  {
    href: '/sample',
    title: 'The sample PRD',
    text: 'Build The Urlist: the complete instruction Burke Holland gave an agent to build a link-sharing app — mocks, stack, routes, exact copy, tests, and a definition of done.',
  },
  {
    href: '/guide',
    title: 'How to write one',
    text: 'Seven habits that separate a PRD an agent can execute from one it has to guess at.',
  },
  {
    href: '/walkthrough',
    title: 'Worked example',
    text: 'The sample, section by section: what each part does, why it works, and what to steal.',
  },
];

const differences = [
  'No follow-up questions — every decision must already be in the document.',
  'Exactness where it matters: routes, copy strings, limits, error messages.',
  'Done is defined by checks the agent can run itself.',
];
---

<Base title={`${SITE.name} — Write a PRD an agent can build`}>
  <section class="hero">
    <h1>Write a PRD an agent can build.</h1>
    <p class="lede">
      A product requirements doc used to be a conversation starter. When the reader is an
      autonomous coding agent, it is the whole conversation. This site shows a real one, explains
      what makes it work, and gives you a template.
    </p>
  </section>

  <ul class="cards">
    {
      cards.map((card) => (
        <li>
          <a class="card" href={card.href}>
            <h2 class="card__title">{card.title}</h2>
            <p>{card.text}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="strip" aria-label="Start here">
    <p class="strip__label">Start here</p>
    <p>
      <a href="/template">Template</a>
      <span class="strip__text">— Copy the skeleton and fill it in.</span>
    </p>
  </section>

  <section class="different">
    <h2>What is different about a PRD for an agent?</h2>
    <ul>
      {differences.map((point) => <li>{point}</li>)}
    </ul>
  </section>
</Base>
