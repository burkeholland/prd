---
import { getEntry } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import { withBase } from '../lib/base';
import { DOC_ROUTES } from '../lib/site';
import {
  WALKTHROUGH_DOWNLOAD_FILENAME,
  WALKTHROUGH_DOWNLOAD_PATH,
} from '../lib/walkthrough-download';

const route = DOC_ROUTES['/walkthrough'];
const entry = await getEntry(route.collection, route.id);
if (!entry) {
  throw new Error('walkthrough: content entry is required');
}
---

<Doc
  label={route.label}
  title={entry.data.title}
  description={entry.data.description}
  entry={entry}
  headerAction={{
    href: withBase(WALKTHROUGH_DOWNLOAD_PATH),
    label: 'Download walkthrough (.md)',
    download: WALKTHROUGH_DOWNLOAD_FILENAME,
  }}
/>
