---
import { getEntry } from 'astro:content';
import guideSource from '../../content/guide.md?raw';
import Doc from '../layouts/Doc.astro';
import { withBase } from '../lib/base';
import {
  extractHandoffChecklistItems,
  HANDOFF_CHECKLIST_DOWNLOAD_PATH,
} from '../lib/handoff-checklist';
import { DOC_ROUTES } from '../lib/site';

const route = DOC_ROUTES['/guide'];
const entry = await getEntry(route.collection, route.id);
const checklistItems = extractHandoffChecklistItems(guideSource);
---

<Doc
  label={route.label}
  title={route.label}
  description={entry?.data.description}
  entry={entry}
>
  <div
    class="guide-checklist-action"
    data-checklist-items={JSON.stringify(checklistItems)}
  >
    <a
      class="guide-checklist-download"
      href={withBase(HANDOFF_CHECKLIST_DOWNLOAD_PATH)}
      download
    >
      Download checklist (.md)
    </a>
  </div>
  <noscript>
    <style is:inline>
      .doc__body:has(> .guide-checklist-action) {
        display: flex;
        flex-direction: column;
      }

      .doc__body > .guide-checklist-action {
        order: 1;
      }

      .doc__body > #before-you-hand-it-off ~ :not(.guide-checklist-action) {
        order: 2;
      }
    </style>
  </noscript>
</Doc>

<script>
  import { serializeHandoffChecklist } from '../lib/handoff-checklist';

  const RESET_LABEL = 'Copy handoff checklist';
  const RESET_DELAY = 2000;
  const action = document.querySelector<HTMLElement>(
    '.guide-checklist-action',
  );
  const heading = document.querySelector<HTMLHeadingElement>(
    '.doc__body h2#before-you-hand-it-off',
  );
  const checklist = heading?.nextElementSibling;

  if (action && checklist instanceof HTMLUListElement) {
    checklist.before(action);
    const renderedItems = Array.from(
      checklist.querySelectorAll<HTMLLIElement>(':scope > li.task-list-item'),
    );
    const sourceItems: unknown = JSON.parse(
      action.dataset.checklistItems ?? 'null',
    );

    if (
      Array.isArray(sourceItems) &&
      sourceItems.every((item): item is string => typeof item === 'string') &&
      renderedItems.length === sourceItems.length &&
      typeof navigator.clipboard?.writeText === 'function'
    ) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'guide-checklist-copy';
      button.textContent = RESET_LABEL;
      button.setAttribute('aria-label', RESET_LABEL);

      const status = document.createElement('p');
      status.className = 'guide-checklist-status';
      status.setAttribute('aria-live', 'polite');
      status.setAttribute('aria-atomic', 'true');

      action.prepend(button);
      action.append(status);

      let copying = false;
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      const showResult = (label: string, state: 'copied' | 'failed') => {
        button.textContent = label;
        button.dataset.state = state;
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          button.textContent = RESET_LABEL;
          delete button.dataset.state;
        }, RESET_DELAY);
      };

      button.addEventListener('click', async () => {
        if (copying) return;

        copying = true;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Copying…';
        delete button.dataset.state;
        clearTimeout(resetTimer);
        status.textContent = '';

        const markdown = serializeHandoffChecklist(sourceItems);

        try {
          await navigator.clipboard.writeText(markdown);
          showResult('Checklist copied', 'copied');
          status.textContent = 'Handoff checklist copied.';
        } catch {
          showResult('Copy failed', 'failed');
          status.textContent = 'Copying the handoff checklist failed.';
        } finally {
          copying = false;
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
      });
    }
  }
</script>

<style is:global>
  .guide-checklist-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .guide-checklist-copy,
  .guide-checklist-download {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
    min-width: 32px;
    min-height: 32px;
    max-width: 100%;
    padding: 0.35rem 0.75rem;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .guide-checklist-copy {
    cursor: pointer;
  }

  .guide-checklist-download {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .guide-checklist-copy:hover:not(:disabled),
  .guide-checklist-copy:focus-visible,
  .guide-checklist-download:hover,
  .guide-checklist-download:focus-visible {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .guide-checklist-copy:disabled {
    cursor: wait;
  }

  .guide-checklist-copy[data-state='copied'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .guide-checklist-copy[data-state='failed'] {
    color: var(--text);
  }

  .guide-checklist-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media print {
    .guide-checklist-action,
    .guide-checklist-status {
      display: none !important;
    }
  }
</style>
