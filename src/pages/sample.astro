---
import { getEntry } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import { DOC_ROUTES, SITE } from '../lib/site';
import { withBase } from '../lib/base';
// Written by scripts/fetch-gist.mjs next to the snapshot: html_url, revision, fetched_at, updated_at.
import meta from '../../content/gist/meta.json';
// Written by scripts/fetch-gist-history.mjs: one entry per gist revision, oldest → newest.
import history from '../../content/gist/history.json';

const route = DOC_ROUTES['/sample'];
const entry = await getEntry(route.collection, route.id);

const intro = {
  lead: 'A complete PRD for a link-sharing app, shown exactly as written. It includes mocks, stack choices, routes, data rules, exact interface copy, tests, and completion checks.',
  rest: 'The screenshots show the reference product described by the document.',
};
const description = intro.lead;

const gistUrl = meta.html_url || SITE.gistUrl;
const revision = meta.revision || undefined;
const shortRevision = revision?.slice(0, 7);
// The day the snapshot was taken, as a date only ("mirrored 2026-08-31"); no time of day.
const mirroredAt = meta.fetched_at ? new Date(meta.fetched_at) : undefined;
const mirroredLabel =
  mirroredAt && !Number.isNaN(mirroredAt.getTime()) ? mirroredAt.toISOString().slice(0, 10) : meta.fetched_at;
// Where the snapshot sits in the gist's history ("Gist revision 16 of 16"). Undefined when the
// snapshot and the history were fetched out of step; the card then shows the revision alone.
const current = history.revisions.find((rev) => rev.version === meta.revision);
const revisionLabel = current ? `Gist revision ${current.n} of ${history.count}` : 'Gist revision';
---

<Doc label={route.label} title={route.label} description={description} entry={entry}>
  <div slot="header" class="source-card">
    <h1 class="source-card__title">{route.label}</h1>
    <p>{intro.lead}</p>
    <p>{intro.rest}</p>
    <ul class="source-card__links">
      <li><a href={gistUrl}>View original</a></li>
      <li><a href={withBase('/raw/build-the-urlist.md')} download>Download .md</a></li>
      <li><a href={withBase('/history/')}>Revision history</a></li>
    </ul>
    {
      (mirroredLabel || revision) && (
        <p class="source-card__meta">
          {revision && (
            <span>
              {revisionLabel} (<a href={`${gistUrl}/${revision}`} title={revision}><code>{shortRevision}</code></a>)
            </span>
          )}
          {revision && mirroredLabel && ' · '}
          {mirroredLabel && (
            <span>
              mirrored <time datetime={meta.fetched_at}>{mirroredLabel}</time>
            </span>
          )}
        </p>
      )
    }
  </div>
</Doc>

<!--
  Progressive enhancement, this page only: a "Copy the PRD" action beside "Download .md" that puts
  the raw gist (public/raw/build-the-urlist.md, read from the Download link's own href) on the
  clipboard. Astro bundles the script as a module; without JavaScript or the Clipboard API the
  button never appears and the page is exactly the card as rendered, Download being the fallback.
-->
<script>
  const RESET = 'Copy the PRD';
  const links = document.querySelector('ul.source-card__links');
  const download = links?.querySelector<HTMLAnchorElement>('a[download]');
  const card = links?.closest('.source-card');

  if (links && download && card && navigator.clipboard?.writeText && typeof fetch === 'function') {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-prd';
    button.textContent = RESET;
    const item = document.createElement('li');
    item.append(button);
    // Anchored on the Download item, not its position, so the row can change around it.
    download.closest('li')?.after(item);

    // One polite live region so screen readers hear the result; created up front (a region
    // added at announce time is not reliably read) and visually hidden, never display:none.
    const status = document.createElement('p');
    status.className = 'copy-prd-status';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    card.append(status);

    let timer: ReturnType<typeof setTimeout> | undefined;
    const show = (text: string, copied: boolean, ms: number) => {
      button.textContent = text;
      if (copied) button.dataset.state = 'copied';
      timer = setTimeout(() => {
        button.textContent = RESET;
        delete button.dataset.state;
      }, ms);
    };

    button.addEventListener('click', async () => {
      if (button.getAttribute('aria-busy') === 'true') return;
      button.setAttribute('aria-busy', 'true');
      button.textContent = 'Copying…';
      delete button.dataset.state;
      clearTimeout(timer);
      // Cleared first so an identical result (a second copy) is announced again.
      status.textContent = '';
      let message: string;
      try {
        const response = await fetch(download.href, { cache: 'force-cache' });
        if (!response.ok) throw new Error(String(response.status));
        // The gist's bytes as text, line endings untouched (CRLF today).
        const text = await response.text();
        await navigator.clipboard.writeText(text);
        message = `Copied the PRD (${(new TextEncoder().encode(text).length / 1000).toFixed(1)} KB)`;
        show('Copied', true, 1500);
      } catch {
        message = 'Copy failed — use Download .md';
        show(message, false, 3000);
      } finally {
        button.removeAttribute('aria-busy');
      }
      status.textContent = message;
    });
  }
</script>

<!--
  Global: the button and live region are created at runtime, so scoped styles would not reach
  them. At rest the button reads as one of the card's links (global.css `a` + `.source-card__links a`).
-->
<style is:global>
  /* Same negative-margin hit area as `.source-card__links a`: >= 32 px tall, text and row unmoved. */
  .copy-prd {
    display: inline-block;
    margin: -0.25em -0.6em;
    padding: 0.25em 0.6em;
    font: inherit;
    font-weight: 600;
    color: var(--accent);
    background: none;
    border: 0;
    cursor: pointer;
    /* Top-aligned, not baseline: the hidden ::after below would otherwise lower the button's
       baseline and grow the row by its own height. */
    vertical-align: top;
    text-align: start;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  /* Reserves the width of the resting label in whatever system font is rendering it, so the
     shorter "Copied" does not narrow the button and shove "Revision history" sideways. Zero height
     and hidden: never painted, never read out. The failure label is longer and may grow the button. */
  .copy-prd::after {
    content: 'Copy the PRD';
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .copy-prd:hover {
    text-decoration-thickness: 2px;
  }

  .copy-prd[data-state='copied'] {
    color: var(--text-muted);
  }

  .copy-prd[aria-busy='true'] {
    cursor: progress;
  }

  /* Visually hidden, not `hidden`: a display:none live region is never announced. */
  .copy-prd-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>