---
import { getEntry } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import { DOC_ROUTES, SITE } from '../lib/site';
import { withBase } from '../lib/base';
// Written by scripts/fetch-gist.mjs next to the snapshot: html_url, revision, fetched_at, updated_at.
import meta from '../../content/gist/meta.json';
// Written by scripts/fetch-gist-history.mjs: one entry per gist revision, oldest → newest.
import history from '../../content/gist/history.json';

const route = DOC_ROUTES['/sample'];
const entry = await getEntry(route.collection, route.id);

const description =
  'This is the gist, verbatim except that screenshot URLs point at local copies.';

// The gist carries its own h1 (`# Build The Urlist`), so the card's heading is an h1 only
// while the content is absent and the placeholder shows.
const Heading = entry ? 'p' : 'h1';
const gistUrl = meta.html_url || SITE.gistUrl;
const revision = meta.revision || undefined;
const shortRevision = revision?.slice(0, 7);
const fetchedAt = meta.fetched_at ? new Date(meta.fetched_at) : undefined;
const fetchedLabel =
  fetchedAt && !Number.isNaN(fetchedAt.getTime())
    ? fetchedAt.toISOString().replace('T', ' ').slice(0, 16) + ' UTC'
    : meta.fetched_at;
// Where the snapshot sits in the gist's history ("16 of 16"). Undefined when the snapshot and
// the history were fetched out of step; the card then shows the revision alone.
const current = history.revisions.find((rev) => rev.version === meta.revision);
---

<Doc label={route.label} title={route.label} description={description} entry={entry}>
  <div slot="header" class="source-card">
    <Heading class="source-card__title">{route.label}</Heading>
    <p>{description}</p>
    <ul class="source-card__links">
      <li><a href={gistUrl}>View on GitHub</a></li>
      <li><a href={withBase('/raw/build-the-urlist.md')} download>Download .md</a></li>
      <li><a href={withBase('/history/')}>How it evolved</a></li>
    </ul>
    {
      (fetchedLabel || revision) && (
        <p class="source-card__meta">
          {fetchedLabel && (
            <span>
              Last fetched <time datetime={meta.fetched_at}>{fetchedLabel}</time>
            </span>
          )}
          {fetchedLabel && revision && ' · '}
          {revision && (
            <span>
              Revision{' '}
              <a href={`${gistUrl}/${revision}`} title={revision}>
                <code>{shortRevision}</code>
              </a>
              {current && ` (${current.n} of ${history.count})`}
            </span>
          )}
        </p>
      )
    }
  </div>
</Doc>