---
import { getEntry } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import { DOC_ROUTES } from '../lib/site';
import { withBase } from '../lib/base';
import { PRD_TEMPLATE, serializeBlankPrdMarkdown } from '../lib/prd-template';
import { PRD_TEMPLATE_ALIASES } from '../lib/prd-template-compat';

const route = DOC_ROUTES['/template'];
const entry = await getEntry(route.collection, route.id);
const title = entry?.data.title ?? route.label;
const description = entry?.data.description;
const headings = PRD_TEMPLATE.sections.map(({ id, title }) => ({
  depth: 2,
  slug: id,
  text: title,
}));
// Copy the serializer's complete sections, including their Markdown headings.
const blankSections = serializeBlankPrdMarkdown().split(/(?=^## )/m).slice(1).map((text) => text.trimEnd());
const aliases = Object.entries(PRD_TEMPLATE_ALIASES);
---

<Doc label={route.label} title={title} description={description} entry={entry} headings={headings}>
  <Fragment slot="header">
    <h1>{title}</h1>
    {description && <p class="doc__description">{description}</p>}
    <p class="doc__actions">
      <a class="button" href={withBase('/')}>Open the editor</a>
    </p>
    <p class="doc__actions">
      <span class="doc__actions-note">Download a blank file:</span>
      <a class="template-download" href={withBase('/downloads/prd-template.md')} download>Markdown</a>
      <a class="template-download" href={withBase('/downloads/prd-template.docx')} download>Word (.docx)</a>
      <a class="template-download" href={withBase('/downloads/prd-template.pdf')} download>PDF</a>
    </p>
  </Fragment>
  <p>{PRD_TEMPLATE.guidance} Replace the placeholders you keep with your own decisions.</p>
  {
    PRD_TEMPLATE.sections.map((section, index) => (
      <section class="template-section" aria-labelledby={section.id}>
        <h2 id={section.id}><a class="heading-link" href={`#${section.id}`}>{section.title}</a></h2>
        {aliases.filter(([, target]) => target === section.id).map(([alias]) => (
          <span id={alias} class="template-alias" aria-hidden="true" />
        ))}
        <p class="template-prompt">{section.prompt}</p>
        <ul>
          {section.helperQuestions.map((question) => <li>{question}</li>)}
        </ul>
        <pre data-section-title={section.title}><code>{blankSections[index]}</code></pre>
      </section>
    ))
  }
</Doc>

<!--
  Copy is a progressive enhancement; the annotated sections and files work without JavaScript.
-->
<script>
  const RESET = 'Copy';
  const main = document.querySelector('main');
  let status: HTMLParagraphElement | undefined;

  /** Mirrors the last result in one polite live region so screen readers hear it. */
  const announce = (message: string) => {
    if (!main) return;
    if (!status) {
      status = document.createElement('p');
      status.className = 'copy-status';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      main.append(status);
    }
    status.textContent = message;
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>('main .prose pre[data-section-title]')) {
    const code = pre.querySelector('code') ?? pre;
    const block = document.createElement('div');
    block.className = 'code-block';
    pre.replaceWith(block);
    block.append(pre);

    const section = `the ${pre.dataset.sectionTitle} section`;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = RESET;
    button.setAttribute('aria-label', `Copy ${section}`);
    block.prepend(button);

    let timer: ReturnType<typeof setTimeout> | undefined;
    const show = (text: string, copied: boolean, ms: number) => {
      button.textContent = text;
      if (copied) button.dataset.state = 'copied';
      else delete button.dataset.state;
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.textContent = RESET;
        delete button.dataset.state;
      }, ms);
    };

    button.addEventListener('click', async () => {
      const text = (code.textContent ?? '').replace(/\n$/, '');
      try {
        if (!navigator.clipboard) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(text);
        show('Copied', true, 1500);
        announce(`Copied ${section}`);
      } catch {
        getSelection()?.selectAllChildren(code);
        show('Copy failed', false, 3000);
        announce('Copy failed — text selected. Press Ctrl+C or Command+C to copy.');
      }
    });
  }
</script>

<!-- Global: the buttons and wrappers are created at runtime, so scoped styles would not reach them. -->
<style is:global>
  .template-section {
    position: relative;
  }

  .prose .template-section {
    margin-top: 3.48rem;
  }

  .template-section > h2 {
    margin-top: 0;
  }

  .template-section > :is(p, ul, pre, .code-block) {
    margin-top: 1.1em;
  }

  .template-alias {
    position: absolute;
    top: 0;
  }

  .template-download,
  .template-section .heading-link,
  .doc__body > p a {
    display: inline-block;
    min-height: 32px;
    min-width: 32px;
  }

  .template-download {
    padding-block: 0.2rem;
  }

  .code-block {
    position: relative;
  }

  /* padding-block makes the button >= 32 px tall for thumbs; the width is the label's alone. */
  .copy-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.45rem 0.6rem;
    min-height: 32px;
    min-width: 32px;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .copy-button:hover {
    border-color: var(--text-muted);
  }

  .copy-button[data-state='copied'] {
    color: var(--accent);
  }

  /* Reserve a row for both success and failure labels without narrowing the code. */
  @media screen {
    .prose .code-block pre {
      padding-top: 3rem;
    }
  }

  /* Keep long section titles readable without sideways scrolling; copying still uses textContent. */
  .prose pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media print {
    .copy-button {
      display: none;
    }
  }

  /* Visually hidden, not `hidden`: a display:none live region is never announced. */
  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>