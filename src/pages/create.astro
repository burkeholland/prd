---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
import { PRD_TEMPLATE } from '../lib/prd-template';

const title = 'Create a PRD';
const description =
  'Draft a product requirements document from a practical, adaptable template and keep it in this browser.';
const blankDownloads = [
  { format: 'Markdown', extension: 'md' },
  { format: 'Word', extension: 'docx' },
  { format: 'PDF', extension: 'pdf' },
] as const;
---

<Base title={title} description={description}>
  <noscript>
    <section class="editor-nojs" aria-labelledby="nojs-heading">
      <h1 id="nojs-heading">{title}</h1>
      <p>The online editor needs JavaScript, but the blank template is available without it.</p>
      <ul class="editor-blank-links">
        {
          blankDownloads.map(({ format, extension }) => (
            <li>
              <a href={withBase(`/downloads/prd-template.${extension}`)} download>
                Download the blank {format} template
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </noscript>

  <div class="editor-page" data-prd-editor hidden>
    <header class="editor-header">
      <h1>{title}</h1>
      <p>{PRD_TEMPLATE.guidance}</p>
      <p class="editor-privacy">Draft content stays in this browser unless you download it.</p>
      <p class="editor-blank-downloads">
        <strong>Blank template:</strong>
        {
          blankDownloads.map(({ format, extension }) => (
            <a href={withBase(`/downloads/prd-template.${extension}`)} download>
              {format}
            </a>
          ))
        }
      </p>
    </header>

    <div class="editor-summary" aria-label="Draft status">
      <p><output id="completion-count">0 of 12 sections completed</output></p>
      <p id="save-status" role="status" aria-live="polite" aria-atomic="true">
        Checking this browser for a saved draft.
      </p>
    </div>

    <div class="editor-shell">
      <aside class="editor-outline">
        <nav aria-labelledby="outline-heading">
          <h2 id="outline-heading">Document outline</h2>
          <ol>
            {
              PRD_TEMPLATE.sections.map((section) => (
                <li>
                  <a href={`#section-${section.id}`} data-outline-target={section.id}>
                    {section.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <form id="prd-editor-form" class="editor-form">
        <div class="editor-title-field">
          <label for="document-title">Document title</label>
          <input
            id="document-title"
            name="title"
            type="text"
            autocomplete="off"
            placeholder={PRD_TEMPLATE.defaultTitle}
          />
        </div>

        {
          PRD_TEMPLATE.sections.map((section, index) => (
            <section id={`section-${section.id}`} class="editor-section">
              <h2>
                <label for={`section-input-${section.id}`}>
                  {index + 1}. {section.title}
                </label>
              </h2>
              <p id={`section-prompt-${section.id}`} class="editor-prompt">
                {section.prompt}
              </p>
              {section.helperQuestions && (
                <ul id={`section-questions-${section.id}`} class="editor-questions">
                  {section.helperQuestions.map((question) => <li>{question}</li>)}
                </ul>
              )}
              <textarea
                id={`section-input-${section.id}`}
                name={section.id}
                rows="8"
                aria-describedby={`section-prompt-${section.id} section-questions-${section.id}`}
              />
            </section>
          ))
        }

        <section class="editor-downloads" aria-labelledby="download-heading">
          <h2 id="download-heading">Download current draft</h2>
          <div class="editor-download-actions">
            <button
              id="download-md"
              class="editor-button"
              type="button"
              data-export-format="md"
            >
              Markdown (.md)
            </button>
            <button
              id="download-docx"
              class="editor-button"
              type="button"
              data-export-format="docx"
            >
              Word (.docx)
            </button>
            <button
              id="download-pdf"
              class="editor-button"
              type="button"
              data-export-format="pdf"
            >
              PDF (.pdf)
            </button>
          </div>
          <p
            id="download-status"
            class="editor-download-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            Files are generated in this browser.
          </p>
        </section>

        <div class="editor-actions">
          <button id="save-draft" class="editor-button editor-button--primary" type="button">
            Save draft
          </button>
          <button id="start-over" class="editor-button" type="button">Start over</button>
        </div>
      </form>
    </div>
  </div>
</Base>

<script>
  import notoSansRegularUrl from '@fontsource/noto-sans/files/noto-sans-latin-ext-400-normal.woff?url';
  import notoSansBoldUrl from '@fontsource/noto-sans/files/noto-sans-latin-ext-700-normal.woff?url';
  import {
    clearPrdEditorDraft,
    createBlankPrdEditorState,
    loadPrdEditorDraft,
    savePrdEditorDraft,
    type PrdEditorState,
    type PrdEditorStorage,
  } from '../lib/prd-editor-state';
  import {
    prdBytesResponseBody,
    prdExportFilename,
    PRD_EXPORT_MIME_TYPES,
    type PrdExportFormat,
  } from '../lib/prd-export';
  import { PRD_TEMPLATE } from '../lib/prd-template';

  const editor = document.querySelector<HTMLElement>('[data-prd-editor]');
  const form = document.querySelector('#prd-editor-form');
  const titleInput = document.querySelector('#document-title');
  const completion = document.querySelector('#completion-count');
  const status = document.querySelector('#save-status');
  const saveButton = document.querySelector('#save-draft');
  const startOverButton = document.querySelector('#start-over');
  const downloadStatus = document.querySelector('#download-status');
  const downloadButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-export-format]'),
  );

  if (
    !editor ||
    !(form instanceof HTMLFormElement) ||
    !(titleInput instanceof HTMLInputElement) ||
    !(completion instanceof HTMLOutputElement) ||
    !(status instanceof HTMLParagraphElement) ||
    !(saveButton instanceof HTMLButtonElement) ||
    !(startOverButton instanceof HTMLButtonElement) ||
    !(downloadStatus instanceof HTMLParagraphElement) ||
    downloadButtons.length !== 3
  ) {
    throw new Error('The PRD editor markup is incomplete.');
  }

  const sectionInputs = new Map(
    PRD_TEMPLATE.sections.map((section) => {
      const input = document.querySelector(`#section-input-${section.id}`);
      if (!(input instanceof HTMLTextAreaElement)) {
        throw new Error(`The PRD editor field "${section.id}" is missing.`);
      }
      return [section.id, input] as const;
    }),
  );

  const showStatus = (message: string, state: string) => {
    status.textContent = message;
    status.dataset.state = state;
  };

  const showDownloadStatus = (message: string, state: string) => {
    downloadStatus.textContent = message;
    downloadStatus.dataset.state = state;
  };

  const dateFormatter = new Intl.DateTimeFormat(undefined, {
    dateStyle: 'medium',
    timeStyle: 'short',
  });
  const formatSavedAt = (savedAt: string) =>
    dateFormatter.format(new Date(savedAt));

  const readState = (): PrdEditorState => {
    const blank = createBlankPrdEditorState();
    const values = { ...blank.values };
    for (const section of PRD_TEMPLATE.sections) {
      values[section.id] = sectionInputs.get(section.id)?.value ?? '';
    }
    return { title: titleInput.value, values };
  };

  const applyState = (state: PrdEditorState) => {
    titleInput.value = state.title;
    for (const section of PRD_TEMPLATE.sections) {
      const input = sectionInputs.get(section.id);
      if (input) input.value = state.values[section.id];
    }
  };

  const updateCompletion = () => {
    const completed = Array.from(sectionInputs.values()).filter(
      (input) => input.value.trim().length > 0,
    ).length;
    completion.textContent = `${completed} of ${PRD_TEMPLATE.sections.length} sections completed`;
  };

  let storage: PrdEditorStorage | undefined;
  try {
    storage = window.localStorage;
  } catch {
    showStatus(
      'This browser did not allow access to local draft storage. You can still edit this document.',
      'error',
    );
  }

  const persistDraft = (mode: 'automatic' | 'explicit') => {
    if (!storage) {
      showStatus(
        'Draft could not be saved in this browser. You can still edit, but copy your work before leaving.',
        'error',
      );
      return;
    }

    const result = savePrdEditorDraft(storage, readState());
    if (result.status === 'storage-error') {
      showStatus(
        'Draft could not be saved in this browser. You can still edit, but copy your work before leaving.',
        'error',
      );
      return;
    }

    const lead = mode === 'automatic' ? 'Draft saved automatically' : 'Draft saved';
    showStatus(
      `${lead} in this browser at ${formatSavedAt(result.payload.savedAt)}.`,
      'saved',
    );
  };

  if (storage) {
    const restored = loadPrdEditorDraft(storage);
    switch (restored.status) {
      case 'valid':
        applyState(restored.payload.state);
        showStatus(
          `Draft restored from this browser. Last saved ${formatSavedAt(restored.payload.savedAt)}.`,
          'restored',
        );
        break;
      case 'empty':
        showStatus('No draft saved in this browser yet.', 'empty');
        break;
      case 'unsupported-version':
        showStatus(
          `The saved draft uses unsupported version ${restored.version} and was not restored. Save this draft to replace it, or start over to remove it.`,
          'error',
        );
        break;
      case 'corrupt':
        showStatus(
          'The saved draft in this browser is damaged and was not restored. Save this draft to replace it, or start over to remove it.',
          'error',
        );
        break;
      case 'storage-error':
        showStatus(
          'This browser could not read local draft storage. You can still edit this document.',
          'error',
        );
        break;
    }
  }

  updateCompletion();
  editor.hidden = false;

  let autoSaveTimer: number | undefined;
  form.addEventListener('input', () => {
    updateCompletion();
    if (autoSaveTimer !== undefined) window.clearTimeout(autoSaveTimer);
    showStatus('Unsaved changes. Saving in this browser.', 'pending');
    autoSaveTimer = window.setTimeout(() => {
      autoSaveTimer = undefined;
      persistDraft('automatic');
    }, 400);
  });

  saveButton.addEventListener('click', () => {
    if (autoSaveTimer !== undefined) {
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = undefined;
    }
    persistDraft('explicit');
  });

  let pdfFonts:
    | Promise<{ regular: Uint8Array; bold: Uint8Array }>
    | undefined;
  const loadPdfFonts = () => {
    pdfFonts ??= Promise.all(
      [notoSansRegularUrl, notoSansBoldUrl].map(async (url) => {
        const response = await fetch(url);
        if (!response.ok) {
          throw new Error(`PDF font request failed with status ${response.status}.`);
        }
        return new Uint8Array(await response.arrayBuffer());
      }),
    ).then(([regular, bold]) => ({ regular, bold }));
    return pdfFonts;
  };

  const generateDownload = async (
    format: PrdExportFormat,
    state: PrdEditorState,
  ): Promise<Uint8Array> => {
    switch (format) {
      case 'md': {
        const { exportPrdMarkdown } = await import('../lib/prd-export');
        return exportPrdMarkdown(state);
      }
      case 'docx': {
        const { exportPrdDocx } = await import('../lib/prd-export-docx');
        return exportPrdDocx(state);
      }
      case 'pdf': {
        const [{ generatePrdPdf }, fonts] = await Promise.all([
          import('../lib/prd-export-pdf'),
          loadPdfFonts(),
        ]);
        return (await generatePrdPdf(state, fonts)).bytes;
      }
    }
  };

  const startDownload = (
    bytes: Uint8Array,
    format: PrdExportFormat,
    filename: string,
  ) => {
    const blob = new Blob([prdBytesResponseBody(bytes)], {
      type: PRD_EXPORT_MIME_TYPES[format],
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.hidden = true;
    document.body.append(link);
    try {
      link.click();
    } finally {
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 0);
    }
  };

  for (const button of downloadButtons) {
    button.addEventListener('click', async () => {
      const format = button.dataset.exportFormat as PrdExportFormat;
      const state = readState();
      const filename = prdExportFilename(state.title, format);
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      showDownloadStatus(`Generating ${filename}.`, 'pending');
      try {
        const bytes = await generateDownload(format, state);
        startDownload(bytes, format, filename);
        showDownloadStatus(`Downloaded ${filename}.`, 'downloaded');
      } catch (error) {
        console.error(`Could not generate ${format} download.`, error);
        showDownloadStatus(
          `Download failed for ${filename}. Your draft is unchanged.`,
          'error',
        );
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  }

  startOverButton.addEventListener('click', () => {
    const confirmed = window.confirm(
      'Start over? This removes the local draft from this browser and clears all fields.',
    );
    if (!confirmed) return;

    if (autoSaveTimer !== undefined) {
      window.clearTimeout(autoSaveTimer);
      autoSaveTimer = undefined;
    }
    form.reset();
    updateCompletion();

    if (!storage) {
      showStatus(
        'All fields are clear, but browser storage was unavailable, so the local draft could not be removed.',
        'error',
      );
    } else {
      const result = clearPrdEditorDraft(storage);
      showStatus(
        result.status === 'cleared'
          ? 'Local draft removed. All fields are clear.'
          : 'All fields are clear, but the local draft could not be removed from this browser.',
        result.status === 'cleared' ? 'cleared' : 'error',
      );
    }
    titleInput.focus();
  });

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-outline-target]')) {
    link.addEventListener('click', (event) => {
      const id = link.dataset.outlineTarget;
      const section = PRD_TEMPLATE.sections.find((candidate) => candidate.id === id);
      const input = section ? sectionInputs.get(section.id) : undefined;
      if (!section || !input) return;
      event.preventDefault();
      history.replaceState(null, '', link.hash);
      input.focus({ preventScroll: true });
      document.getElementById(`section-${section.id}`)?.scrollIntoView({ block: 'start' });
    });
  }

  window.addEventListener('pagehide', () => {
    if (autoSaveTimer === undefined) return;
    window.clearTimeout(autoSaveTimer);
    autoSaveTimer = undefined;
    persistDraft('automatic');
  });
</script>

<style>
  .editor-nojs,
  .editor-page {
    display: grid;
    gap: 1.5rem;
  }

  .editor-page[hidden] {
    display: none;
  }

  .editor-nojs {
    max-width: var(--measure);
  }

  .editor-nojs p {
    margin-top: 1rem;
  }

  .editor-blank-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .editor-header {
    max-width: var(--measure);
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .editor-header > p {
    color: var(--text-muted);
  }

  .editor-privacy {
    font-size: 0.92rem;
  }

  .editor-blank-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    align-items: baseline;
    font-size: 0.92rem;
  }

  .editor-summary {
    max-width: var(--measure);
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  #completion-count {
    font-weight: 650;
  }

  #save-status {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  #save-status[data-state='error'] {
    color: var(--text);
  }

  .editor-download-status[data-state='error'] {
    color: var(--text);
  }

  .editor-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .editor-shell > * {
    min-width: 0;
  }

  .editor-outline {
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .editor-outline h2 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .editor-outline ol {
    margin: 0;
    padding-left: 1.4rem;
  }

  .editor-outline li + li {
    margin-top: 0.15rem;
  }

  .editor-outline a {
    display: flex;
    align-items: center;
    min-height: 2rem;
    padding-block: 0.2rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.35;
    text-decoration: none;
  }

  .editor-outline a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .editor-form {
    display: grid;
    gap: 2.5rem;
    min-width: 0;
  }

  .editor-title-field {
    display: grid;
    gap: 0.5rem;
  }

  .editor-title-field label,
  .editor-section label {
    font-weight: 650;
  }

  .editor-title-field label {
    font-size: 1.15rem;
  }

  .editor-title-field input,
  .editor-section textarea {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 0.7rem 0.8rem;
    font: inherit;
    line-height: 1.5;
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .editor-title-field input {
    min-height: 2.75rem;
    font-size: 1.05rem;
  }

  .editor-title-field input:hover,
  .editor-section textarea:hover {
    border-color: var(--text-muted);
  }

  .editor-section {
    display: grid;
    gap: 0.65rem;
    min-width: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    scroll-margin-top: 1rem;
  }

  .editor-section h2 {
    font-size: 1.25rem;
  }

  .editor-section label {
    cursor: pointer;
  }

  .editor-prompt {
    color: var(--text-muted);
  }

  .editor-questions {
    margin: 0;
    padding-left: 1.3rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .editor-questions li + li {
    margin-top: 0.2rem;
  }

  .editor-section textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .editor-downloads {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .editor-downloads h2 {
    font-size: 1.25rem;
  }

  .editor-download-actions,
  .editor-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .editor-download-status {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .editor-actions {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .editor-button {
    min-height: 2rem;
    padding: 0.55rem 0.9rem;
    font: inherit;
    font-weight: 650;
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .editor-button:hover {
    border-color: var(--text-muted);
  }

  .editor-button--primary {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (min-width: 900px) {
    .editor-shell {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 3rem;
    }

    .editor-outline {
      position: sticky;
      top: 1.5rem;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
    }
  }
</style>
